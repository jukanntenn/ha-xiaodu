{
  "hooks": {
    "enabled": true,
    "events": {
      "PostToolUse": [
        {
          "matcher": "^(Edit|Write)$",
          "hooks": [
            {
              "type": "command",
              "command": "python \"$(git rev-parse --show-toplevel)/.claude/hooks/post-edit-format.py\"",
              "timeout": 10
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python \"$(git rev-parse --show-toplevel)/.claude/hooks/stop-lint.py\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
