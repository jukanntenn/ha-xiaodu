{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_use.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$(git rev-parse --show-toplevel)/.codex/hooks/stop.py\""
          }
        ]
      }
    ]
  }
}
